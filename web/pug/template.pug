doctype html
html
    head
        title Sacral
        link(href="https://fonts.googleapis.com/css?family=Rubik:300,400,500", rel="stylesheet")
        // css
        link(rel="stylesheet" type="text/css" href="/global.css")
    if !loggedIn
        body.logged-out
            main.page-container !{pageHTML}
    if loggedIn
        body.logged-in
            header.page-header
                h2.logo Sacral
                .header-tab.current-page Links
                .header-tab Settings
                .header-tab Logout
            main.page-container !{pageHTML}
    script
        | window.loggedIn = !{loggedIn};
        | window.page = "!{page}";
    script(src="/global.js?r=5")
